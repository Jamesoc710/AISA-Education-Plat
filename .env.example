# AISA Atlas / TCO environment variables.
# Local dev: pull the real values with
#   npx vercel env pull --environment=production .env.local
# (.env* files are gitignored). Delete the file when you're done; it holds prod secrets.

# Postgres (Supabase). Runtime uses the transaction pooler (port 6543);
# migrations and scripts use the session pooler (port 5432) via DIRECT_URL.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Supabase auth + storage
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
# Server only (feedback image uploads). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# Claude: short-answer grading, digest pipeline, calendar topic tagging.
ANTHROPIC_API_KEY="<key>"

# Vercel cron auth. Cron routes return 401 when this is unset.
CRON_SECRET="<random string>"

# SharePoint share link to the TCO Master Calendar sheet (daily calendar sync).
SCHEDULE_SHEET_URL="<sharepoint share link>"
